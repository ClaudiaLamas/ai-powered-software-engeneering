# Variáveis do backend. Copia para .env e muda os valores.
# Valores fictícios: não uses estes valores fora da máquina local.

# Porta da API
PORT=3000

# Ligação ao PostgreSQL do docker-compose.yml (os mesmos valores do .env da raiz)
DATABASE_URL=postgresql://matriz:muda-esta-palavra-passe@localhost:5432/matriz?schema=public

# Segredo para assinar os JWT (D06). Gera um valor aleatório e longo.
JWT_SECRET=muda-este-segredo

# Palavra-passe das contas de demonstração do seed (npm run db:seed).
# Pelo menos 12 caracteres. Fictícia: escolhe uma só para a máquina local.
SEED_DEMO_PASSWORD=muda-esta-palavra-passe-demo
