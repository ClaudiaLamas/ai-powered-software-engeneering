# Variáveis do compose.yaml. Copia para .env e muda os valores.
# Valores fictícios: não uses estes valores fora da máquina local.

# --- PostgreSQL (sempre obrigatórias) ---
POSTGRES_USER=matriz
# Usa só letras, algarismos, "-" e "_": o valor entra no DATABASE_URL dos containers.
POSTGRES_PASSWORD=muda-esta-palavra-passe
POSTGRES_DB=matriz
# Porta da máquina onde o PostgreSQL fica disponível (só em 127.0.0.1).
POSTGRES_PORT=5432

# --- Aplicação em containers (docker compose up -d --build) ---
# Porta da máquina onde a aplicação fica disponível (só em 127.0.0.1).
FRONTEND_PORT=8080
# Segredo para assinar os JWT (D06). Obrigatório e sem valor de exemplo:
# gera um e cola-o a seguir ao "=", com
#   openssl rand -hex 32
# A API não arranca sem ele nem com menos de 32 caracteres.
JWT_SECRET=
# Validade dos JWT, em segundos (D06: 1 hora). Opcional; por omissão, 3600.
JWT_EXPIRES_IN_SECONDS=3600
# Palavra-passe das contas de demonstração do seed
# (docker compose run --rm migrate npm run db:seed). Pelo menos 12 caracteres.
SEED_DEMO_PASSWORD=muda-esta-palavra-passe-demo
